<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ExampleUplink</AssemblyName>
    <RootNamespace>ExampleUplink</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Lets the project build on macOS and Linux, where the .NET Framework
       reference assemblies are not installed with the SDK. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The only Gonogo assembly an Uplink may reference. Point SitrepContractDll
       at the copy your KSP install already has:
       GameData/Gonogo/Plugins/Sitrep.Contract.dll

       Private="false" is required. KSP loads every GameData plugin into one
       AppDomain, so shipping your own copy of Sitrep.Contract.dll would shadow
       the one Gonogo loaded. -->
  <ItemGroup>
    <Reference Include="Sitrep.Contract" Private="false">
      <HintPath>$(SitrepContractDll)</HintPath>
    </Reference>
  </ItemGroup>

</Project>
