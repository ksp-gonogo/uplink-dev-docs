{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@ksp-gonogo/sitrep-sdk": [
        "../../.reference/node_modules/@ksp-gonogo/sitrep-sdk"
      ],
      "@ksp-gonogo/sitrep-sdk/*": [
        "../../.reference/node_modules/@ksp-gonogo/sitrep-sdk/dist/*"
      ],
      "@ksp-gonogo/ui-kit": ["../../.reference/node_modules/@ksp-gonogo/ui-kit"],
      "@ksp-gonogo/ui-kit/grid": [
        "../../.reference/node_modules/@ksp-gonogo/ui-kit/dist/gridUnits"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
